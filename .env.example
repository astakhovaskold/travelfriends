# URL-safe password: use letters and digits (or percent-encode in DATABASE_URL).
POSTGRES_PASSWORD=replace_with_a_random_alphanumeric_password
DATABASE_URL=postgresql+psycopg://travelfriends:replace_with_a_random_alphanumeric_password@localhost:5432/travelfriends
# Optional for the API; required only when enabling the telegram Compose profile.
BOT_TOKEN=
BOT_USERNAME=
WEBAPP_URL=http://localhost:8000
ADMIN_ID=0
BOOST_STARS=50
# For HTTPS reverse proxy deployment: list only the trusted proxy IPs seen by Uvicorn.
# Do not use * on an API reachable by untrusted clients.
FORWARDED_ALLOW_IPS=127.0.0.1
