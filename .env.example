# Root Compose: production builds of the whole application.
POSTGRES_PASSWORD=replace_with_a_random_alphanumeric_password
# Optional external PostgreSQL/Neon; omit these to use the bundled database.
# DATABASE_URL=
# MIGRATION_DATABASE_URL=
API_BIND_HOST=127.0.0.1
API_PORT=8000
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=8080
# Browser-accessible API origin, not the Docker service name.
VITE_API_URL=http://localhost:8000
WEBAPP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
BOT_TOKEN=
BOT_USERNAME=
ADMIN_ID=0
BOOST_STARS=50
SESSION_TTL=2592000
FORWARDED_ALLOW_IPS=127.0.0.1
