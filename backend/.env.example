# Native development with Postgres.app. Copy to backend/.env.local.
# Docker Compose uses its own PostgreSQL by default (see README).
DATABASE_URL=postgresql+psycopg://localhost:5432/travelfriends_db
# Leave empty/unset to use DATABASE_URL for migrations.
# MIGRATION_DATABASE_URL=
WEBAPP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
BOT_TOKEN=
BOT_USERNAME=
ADMIN_ID=0
BOOST_STARS=50
SESSION_TTL=2592000
